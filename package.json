{
	"name": "pi-auto-route",
	"version": "1.4.0",
	"description": "A pi virtual model that routes each turn to the right physical model by task difficulty and adjusts the thinking level, plus an optional local-model router.",
	"keywords": [
		"pi-package",
		"pi",
		"virtual-model"
	],
	"license": "MIT",
	"author": "rzph",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rzph/pi-auto-route.git"
	},
	"homepage": "https://github.com/rzph/pi-auto-route#readme",
	"bugs": {
		"url": "https://github.com/rzph/pi-auto-route/issues"
	},
	"files": [
		"auto-route.ts",
		"inkling/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test *.test.ts",
		"typecheck": "tsc -p tsconfig.json"
	},
	"pi": {
		"extensions": [
			"./auto-route.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	}
}
